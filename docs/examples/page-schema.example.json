{
  "page": {
    "id": "orders.list",
    "title": "订单列表",
    "layout": "dashboard",
    "sections": [
      {
        "id": "orders.list.header",
        "component": "PageHeader",
        "role": "header",
        "label": "订单页标题区",
        "variant": "default",
        "props": {
          "title": "订单管理",
          "description": "查看、筛选和导出订单数据",
          "actions": [
            {
              "component": "Button",
              "variant": "primary",
              "label": "导出"
            }
          ]
        }
      },
      {
        "id": "orders.list.filters",
        "component": "FilterBar",
        "role": "filters",
        "label": "订单筛选区",
        "variant": "default",
        "props": {
          "fields": [
            {
              "type": "select",
              "name": "status",
              "label": "订单状态",
              "options": ["全部", "待付款", "待发货", "已完成"]
            },
            {
              "type": "dateRange",
              "name": "createdAt",
              "label": "下单时间"
            },
            {
              "type": "search",
              "name": "keyword",
              "label": "客户或订单号"
            }
          ]
        }
      },
      {
        "id": "orders.list.table",
        "component": "DataTable",
        "role": "table",
        "label": "订单数据表格",
        "variant": "default",
        "props": {
          "columns": [
            { "key": "orderNo", "label": "订单号" },
            { "key": "customer", "label": "客户" },
            { "key": "amount", "label": "金额" },
            { "key": "status", "label": "状态" },
            { "key": "createdAt", "label": "下单时间" }
          ],
          "rowActions": ["查看详情", "导出"]
        }
      }
    ]
  }
}
