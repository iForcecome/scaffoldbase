{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specflow.local/schemas/ai-operation.schema.json",
  "title": "SpecFlow AI Operation Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["operations"],
  "properties": {
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/replaceText" },
          { "$ref": "#/$defs/setVariant" },
          { "$ref": "#/$defs/updateStyle" },
          { "$ref": "#/$defs/replaceClass" },
          { "$ref": "#/$defs/insertComponent" },
          { "$ref": "#/$defs/bindSpec" },
          { "$ref": "#/$defs/updateToken" }
        ]
      }
    }
  },
  "$defs": {
    "sfId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "replaceText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "text"],
      "properties": {
        "type": { "const": "replaceText" },
        "target": { "$ref": "#/$defs/sfId" },
        "text": { "type": "string", "maxLength": 2000 }
      }
    },
    "setVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "variant"],
      "properties": {
        "type": { "const": "setVariant" },
        "target": { "$ref": "#/$defs/sfId" },
        "variant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_-]+$"
        }
      }
    },
    "updateStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "styles"],
      "properties": {
        "type": { "const": "updateStyle" },
        "target": { "$ref": "#/$defs/sfId" },
        "styles": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "additionalProperties": {
            "type": "string",
            "maxLength": 160
          },
          "propertyNames": {
            "enum": [
              "display",
              "flexDirection",
              "justifyContent",
              "alignItems",
              "gap",
              "padding",
              "margin",
              "width",
              "height",
              "backgroundColor",
              "color",
              "borderRadius",
              "borderColor",
              "fontSize",
              "fontWeight"
            ]
          }
        }
      }
    },
    "replaceClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "className"],
      "properties": {
        "type": { "const": "replaceClass" },
        "target": { "$ref": "#/$defs/sfId" },
        "className": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^[a-zA-Z0-9_:\\/\\.\\-\\s]+$"
        }
      }
    },
    "insertComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parent", "position", "component", "props"],
      "properties": {
        "type": { "const": "insertComponent" },
        "parent": { "$ref": "#/$defs/sfId" },
        "position": {
          "enum": ["before", "after", "inside:start", "inside:end"]
        },
        "component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Z][a-zA-Z0-9]*$"
        },
        "variant": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "props": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "bindSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "specPath"],
      "properties": {
        "type": { "const": "bindSpec" },
        "target": { "$ref": "#/$defs/sfId" },
        "specPath": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        }
      }
    },
    "updateToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tokens"],
      "properties": {
        "type": { "const": "updateToken" },
        "tokens": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 40,
          "additionalProperties": {
            "type": "string",
            "maxLength": 120
          },
          "propertyNames": {
            "pattern": "^(color|space|radius|font|shadow|border)\\.[a-zA-Z0-9._-]+$"
          }
        }
      }
    }
  }
}
