{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specflow.local/schemas/page-schema.schema.json",
  "title": "SpecFlow Page Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["page"],
  "properties": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "layout", "sections"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "layout": {
          "enum": ["dashboard", "marketing", "form-flow", "detail", "settings"]
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "$ref": "#/$defs/componentNode" }
        }
      }
    }
  },
  "$defs": {
    "componentNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component", "props"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "component": {
          "type": "string",
          "pattern": "^[A-Z][a-zA-Z0-9]*$"
        },
        "role": {
          "type": "string",
          "maxLength": 80
        },
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "variant": {
          "type": "string",
          "default": "default",
          "maxLength": 80
        },
        "props": {
          "type": "object",
          "additionalProperties": true
        },
        "children": {
          "type": "array",
          "maxItems": 40,
          "items": { "$ref": "#/$defs/componentNode" }
        }
      }
    }
  }
}
